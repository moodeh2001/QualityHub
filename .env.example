# Set process environment variables; this file is documentation, not auto-loaded.
QH_BASE_URL=http://localhost:4000
QH_DATABASE_DSN=
# Compose API uses db:5432; Python uses localhost:5433.
QH_DATABASE_URL=
QH_JWT_SECRET=
# Explicitly enable creating a disposable private sandbox, held in memory only.
QH_ALLOW_WRITES=0
QH_CREATE_SANDBOX=0
# Alternatively supply an existing private sandbox through process environment.
QH_SANDBOX_KEY=
QH_LOGIN_EMAIL=
QH_LOGIN_PASSWORD=
